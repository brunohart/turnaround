{% import "_day.html.j2" as day %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ fest.festival }} — {{ fest.days[0].date or fest.days[0].name }} → {{ fest.days[-1].date or fest.days[-1].name }} — turnaround</title>
{{ day.style() }}
<style>
  /* the programme: ten days across, one title a row; the guest's screening carries a navy rule,
     a day the print is away is dark, a day the guest is in town has the prime wash */
  .week-table td.day .s { display:block; white-space:nowrap; }
  .week-table td.day .s i { font-style:normal; color:var(--grey); }
  .week-table td.day .s.guest { border-bottom:2px solid var(--blue); }
  .week-table td.day.away { color:var(--grey); opacity:.55; }
  .week-table td.day.guest-day { background:rgba(27,45,79,.05); }
  .week-table td.guest-col { font-family:"JetBrains Mono", ui-monospace, Menlo, monospace; font-size:11px; letter-spacing:.02em; white-space:nowrap; }
  .clash-line { color:var(--grey); margin:8px 0 0; line-height:1.8; }
  .clash-line b { font-weight:500; color:var(--ink); }
</style>
</head>
<body>
<div class="sheet">
  <div class="wash"></div>
  <header>
    <div>
      <div class="stamp mono">{% if diffs %}Festival re-plan{% else %}Festival sheet{% endif %} · {{ days|length }} days · {{ wg.status }}{% if relaxed_total %} · relaxed{% endif %}</div>
      <h1><span class="ghost" aria-hidden="true">{{ fest.festival }}</span>{{ fest.festival }}</h1>
    </div>
    <div class="meta mono">
      <div><b>{{ fest.days[0].name }} {{ fest.days[0].date or "" }} → {{ fest.days[-1].name }} {{ fest.days[-1].date or "" }}</b></div>
      <div>{{ wg.sessions }} screenings · {{ fest.venues|length }} venues · {{ fest.films|length }} titles · {{ fest.strands|length }} strands{% if guests %} · {{ guests }} guest{{ 's' if guests != 1 }}{% endif %}</div>
      {% if relaxed_total %}<div class="given-up">{{ relaxed_total }} term{{ 's' if relaxed_total != 1 }} given up · see each day's proof</div>{% endif %}
      <div><b>{{ "{:,.0f}".format(admissions) }}</b> expected admissions · {{ "{:,}".format(seats) }} seats on offer</div>
      {% if turned_away >= 0.5 %}<div class="given-up">{{ "{:,.0f}".format(turned_away) }} turned away at capacity</div>{% endif %}
      <div>{% if fest.policy.move_min %}{{ fest.policy.move_min }}′ to move a print between venues · {% endif %}{% if clash_minutes %}{{ clash_minutes }}′ of same-strand clash{% if clash_paid %} · {{ "{:,.0f}".format(clash_paid) }} paid{% endif %}{% else %}no two titles of a strand run at once{% endif %}</div>
      <div>solved in {{ wg.solve_seconds }}s</div>
    </div>
  </header>
  <div class="divider"></div>

  <div class="stamp mono">The programme, by title</div>
  <div class="scroll"><table class="week-table">
    <thead><tr><th>Title</th>{% for dd in days %}<th class="day">{{ dd.name }}{% if dd.brief.date %}<br><span style="color:var(--grey);letter-spacing:.06em">{{ dd.brief.date[5:] }}</span>{% endif %}</th>{% endfor %}<th>Screenings</th><th class="num">Expected</th><th>Guest</th></tr></thead>
    <tbody>
    {% for row in title_rows %}
    <tr>
      <td class="title"><b>{{ row.film.title }}</b>{% if row.film.strand %} <span class="tag">{{ row.film.strand }}</span>{% endif %}<br><span class="mono" style="color:var(--grey)">{{ row.film.runtime_min }}′ · {{ row.film.format }}{% if row.film.rating %} · {{ row.film.rating }}{% endif %}{% if row.film.terms.available %} · in town {{ row.film.terms.available|join("/") }}{% endif %}</span></td>
      {% for cell in row.cells %}<td class="day{% if cell.away %} away{% endif %}{% if cell.guest_day %} guest-day{% endif %}{% if not cell.starts %} dark{% endif %}">{% if cell.status not in ("OPTIMAL", "FEASIBLE") %}<span class="status-inf">{{ cell.status }}</span>{% elif cell.starts %}{% for s in cell.starts %}<span class="s{% if s.guest %} guest{% endif %}"{% if s.guest %} title="the guest's screening"{% endif %}>{{ s.hhmm }} <i>{{ s.venue }}</i></span>{% endfor %}{% else %}—{% endif %}</td>{% endfor %}
      <td>{{ row.total }}{% if row.asked is not none %}<span class="mono" style="color:var(--grey)"> /{{ row.asked }}</span>{% endif %}{% if row.screenings_relaxed %} <span class="relaxed mono">relaxed</span>{% elif row.screenings_ok is sameas false %} <span class="fail">✗</span>{% endif %}</td>
      <td class="num">{{ "{:,.0f}".format(row.admissions) }}</td>
      <td class="guest-col">{% if row.guest %}{{ row.guest.name or "guest" }} · {{ row.guest.window }}{% if row.guest_relaxed %} <span class="relaxed mono">relaxed</span>{% elif row.guest_ok is sameas true %} <span class="ok">✓</span>{% elif row.guest_ok is sameas false %} <span class="fail">✗</span>{% endif %}{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% if week_report %}
  <div class="cols" style="margin-top:28px">
    <div class="panel">
      <div class="stamp mono">The festival's proof</div>
      <div class="scroll"><table class="proof">
        <thead><tr><th>Check</th><th>Evidence</th></tr></thead>
        <tbody>
        {% for c in week_report.week.checks %}<tr><td class="{{ 'ok' if c.ok else 'fail' }}">{{ '✓' if c.ok else '✗' }} {{ c.name }}{% if c.film %} <span style="color:var(--grey);font-weight:400">{{ fest.film_title(c.film) }}</span>{% endif %}</td><td>{% if c.relaxed %}<span class="relaxed mono">relaxed</span> {% endif %}{{ c.evidence }}</td></tr>{% endfor %}
        </tbody>
      </table></div>
    </div>
    <div class="panel">
      <div class="stamp mono">Day by day</div>
      <table class="proof">
        <thead><tr><th>Day</th><th>Evidence</th></tr></thead>
        <tbody>
        {% for dd in days %}<tr><td class="{{ 'ok' if dd.report.ok else 'fail' }}">{{ '✓' if dd.report.ok else '✗' }} {{ dd.name }}</td><td>{{ dd.grid.status }} · {{ dd.grid.sessions|length }} screenings · {{ dd.report.checks|selectattr('ok')|list|length }} of {{ dd.report.checks|length }} checks green{% if dd.report.relaxations %} · {{ dd.report.relaxations|length }} relaxed{% endif %}{% if dd.report.failures %} · {{ dd.report.failures|length }} failed{% endif %}{% if dd.grid.clash_paid %} · {{ "{:,.0f}".format(dd.grid.clash_paid) }} paid in clashes{% endif %}</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
  </div>
  {% endif %}

  {% for dd in days %}
  <section class="day-page">
    <div class="day-head">
      <div>
        <div class="stamp mono">{{ dd.name }} · {{ dd.grid.status }}{% if dd.grid.relaxed %} · relaxed{% endif %}{% if dd.diff %} · re-plan · {{ dd.diff.summary }}{% endif %}</div>
        <h2><span class="ghost" aria-hidden="true">{{ dd.name }}</span>{{ dd.name }}{% if dd.brief.date %} <span style="color:var(--grey);font-weight:400">{{ dd.brief.date }}</span>{% endif %}</h2>
      </div>
      <div class="meta mono">
        <div>{{ dd.grid.sessions|length }} screenings · <b>{{ "{:,.0f}".format(dd.d.admissions) }}</b> expected admissions · {{ "{:,}".format(dd.d.seats) }} seats on offer</div>
        {% if dd.d.turned_away >= 0.5 %}<div class="given-up">{{ "{:,.0f}".format(dd.d.turned_away) }} turned away at capacity</div>{% endif %}
        {% if dd.grid.relaxed %}<div class="given-up">{{ dd.grid.relaxed|length }} term{{ 's' if dd.grid.relaxed|length != 1 }} given up · see proof</div>{% endif %}
        <div>doors {{ dd.brief.policy.open }} · last start {{ dd.brief.policy.last_start }} · turnaround {{ dd.brief.policy.clean_min }}′{% if dd.brief.policy.move_min %} · print move {{ dd.brief.policy.move_min }}′{% endif %}</div>
        {% if dd.overrides %}<div>{{ dd.overrides|join(" · ") }}</div>{% endif %}
        <div>solved in {{ dd.grid.solve_seconds }}s · objective {{ "{:,.0f}".format(dd.grid.objective) }}{% if dd.grid.clash_paid %} after {{ "{:,.0f}".format(dd.grid.clash_paid) }} paid in clashes{% endif %}{% if dd.grid.stats and dd.grid.stats.slot_reason %} · on a {{ dd.grid.stats.slot_min }}-minute grid{% endif %}{% if dd.grid.status == "FEASIBLE" and dd.grid.stats and dd.grid.stats.gap is not none %} · not proven best, gap {{ "%.1f"|format(dd.grid.stats.gap * 100) }}%{% endif %}</div>
      </div>
    </div>
    {% if dd.grid.status in ("OPTIMAL", "FEASIBLE") %}
    {{ day.grid(dd.brief, dd.d) }}
    {{ day.replan(dd.d) }}
    {% if dd.clashes %}<p class="clash-line mono">clashes · {% for c in dd.clashes %}<b>{{ c.strand }}</b> {{ c.at }} {{ c.titles|join(" v ") }} {{ c.minutes }}′{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
    {{ day.tables(dd.d, dd.report) }}
    {{ day.strips(dd.brief, dd.d, dd.name ~ (" " ~ dd.brief.date if dd.brief.date else "")) }}
    {% else %}
    <p class="status-inf">{{ dd.grid.status }}{% if dd.explain %} — {{ dd.explain }}{% endif %}</p>
    {% endif %}
  </section>
  {% endfor %}

  <footer class="mono">
    <span>turnaround · the showtime grid, solved</span>
    <span>objective {{ "{:,.0f}".format(wg.objective) }} expected admissions over {{ days|length }} days{% if clash_paid %} · {{ "{:,.0f}".format(clash_paid) }} paid in clashes{% endif %}</span>
  </footer>
</div>
</body>
</html>
