{% import "_day.html.j2" as day %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ week.house }} — the week of {{ week.days[0].date or week.days[0].name }} — turnaround</title>
{{ day.style() }}
</head>
<body>
<div class="sheet">
  <div class="wash"></div>
  <header>
    <div>
      <div class="stamp mono">Week sheet · {{ days|length }} days · {{ wg.status }}{% if relaxed_total %} · relaxed{% endif %}</div>
      <h1><span class="ghost" aria-hidden="true">{{ week.house }}</span>{{ week.house }}</h1>
    </div>
    <div class="meta mono">
      <div><b>{{ week.days[0].name }} {{ week.days[0].date or "" }} → {{ week.days[-1].name }} {{ week.days[-1].date or "" }}</b></div>
      <div>{{ wg.sessions }} sessions · {{ week.screens|length }} screens · {{ week.films|length }} titles</div>
      {% if relaxed_total %}<div class="given-up">{{ relaxed_total }} term{{ 's' if relaxed_total != 1 }} given up · see each day's proof</div>{% endif %}
      <div>{{ "{:,}".format(seats) }} seats on offer</div>
      <div>{{ wg.held|length }} of {{ week.films|length }} titles hold their times {{ wg.hold_days|join("/") }}</div>
      <div>solved in {{ wg.solve_seconds }}s</div>
    </div>
  </header>
  <div class="divider"></div>

  <div class="stamp mono">By title, the week</div>
  <table class="week-table">
    <thead><tr><th>Title</th>{% for dd in days %}<th class="day">{{ dd.name }}{% if dd.brief.date %}<br><span style="color:var(--grey);letter-spacing:.06em">{{ dd.brief.date[5:] }}</span>{% endif %}</th>{% endfor %}<th>Shows</th><th>Holds</th></tr></thead>
    <tbody>
    {% for row in title_rows %}
    <tr>
      <td><b>{{ row.film.title }}</b><br><span class="mono" style="color:var(--grey)">{{ row.film.runtime_min }}′ · {{ row.film.format }}{% if row.film.rating %} · {{ row.film.rating }}{% endif %} · w{{ row.film.weight }}</span></td>
      {% for cell in row.cells %}<td class="day{% if cell.hold %} hold{% endif %}{% if not cell.starts %} dark{% endif %}">{% if cell.status not in ("OPTIMAL", "FEASIBLE") %}<span class="status-inf">{{ cell.status }}</span>{% else %}{{ cell.starts|join("<br>")|safe if cell.starts else "—" }}{% endif %}</td>{% endfor %}
      <td>{{ row.total }}</td>
      <td>{% if row.film.id in wg.held %}<span class="held mono">holds</span>{% endif %}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  {% if week_report %}
  <div class="cols" style="margin-top:28px">
    <div>
      <div class="stamp mono">The week's proof</div>
      <table class="proof">
        <thead><tr><th>Check</th><th>Evidence</th></tr></thead>
        <tbody>
        {% for c in week_report.week.checks %}<tr><td class="{{ 'ok' if c.ok else 'fail' }}">{{ '✓' if c.ok else '✗' }} {{ c.name }}</td><td>{{ c.evidence }}</td></tr>{% endfor %}
        {% for dd in days %}<tr><td class="{{ 'ok' if dd.report.ok else 'fail' }}">{{ '✓' if dd.report.ok else '✗' }} {{ dd.name }}</td><td>{{ dd.grid.status }} · {{ dd.grid.sessions|length }} sessions · {{ dd.report.checks|selectattr('ok')|list|length }} of {{ dd.report.checks|length }} checks green{% if dd.report.relaxations %} · {{ dd.report.relaxations|length }} relaxed{% endif %}{% if dd.report.failures %} · {{ dd.report.failures|length }} failed{% endif %}</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
    <div></div>
  </div>
  {% endif %}

  {% for dd in days %}
  <section class="day-page">
    <div class="day-head">
      <div>
        <div class="stamp mono">{{ dd.name }} · {{ dd.grid.status }}{% if dd.grid.relaxed %} · relaxed{% endif %}{% if dd.hold %} · hold day{% endif %}</div>
        <h2>{{ dd.name }}{% if dd.brief.date %} <span style="color:var(--grey);font-weight:400">{{ dd.brief.date }}</span>{% endif %}</h2>
      </div>
      <div class="meta mono">
        <div>{{ dd.grid.sessions|length }} sessions · {{ "{:,}".format(dd.d.seats) }} seats on offer</div>
        {% if dd.grid.relaxed %}<div class="given-up">{{ dd.grid.relaxed|length }} term{{ 's' if dd.grid.relaxed|length != 1 }} given up · see proof</div>{% endif %}
        <div>doors {{ dd.brief.policy.open }} · last start {{ dd.brief.policy.last_start }} · turnaround {{ dd.brief.policy.clean_min }}′</div>
        {% if dd.overrides %}<div>{{ dd.overrides|join(" · ") }}</div>{% endif %}
        <div>solved in {{ dd.grid.solve_seconds }}s · objective {{ "{:,.0f}".format(dd.grid.objective) }}</div>
      </div>
    </div>
    {% if dd.grid.status in ("OPTIMAL", "FEASIBLE") %}
    {{ day.grid(dd.brief, dd.d) }}
    {{ day.tables(dd.d, dd.report) }}
    {% else %}
    <p class="status-inf">{{ dd.grid.status }}{% if dd.explain %} — {{ dd.explain }}{% endif %}</p>
    {% endif %}
  </section>
  {% endfor %}

  <footer class="mono">
    <span>turnaround · the showtime grid, solved</span>
    <span>objective {{ "{:,.0f}".format(wg.objective) }} weighted seats over {{ days|length }} days</span>
  </footer>
</div>
</body>
</html>
