{% import "_day.html.j2" as day %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brief.house }} — {{ brief.date or "the day" }} — turnaround</title>
{{ day.style() }}
</head>
<body>
<div class="sheet">
  <div class="wash"></div>
  <header>
    <div>
      <div class="stamp mono">Week sheet · {{ grid.status }}{% if grid.relaxed %} · relaxed{% endif %}</div>
      <h1><span class="ghost" aria-hidden="true">{{ brief.house }}</span>{{ brief.house }}</h1>
    </div>
    <div class="meta mono">
      <div><b>{{ brief.date or "—" }}</b></div>
      <div>{{ grid.sessions|length }} sessions · {{ brief.screens|length }} screens · {{ brief.films|length }} titles</div>
      {% if grid.relaxed %}<div class="given-up">{{ grid.relaxed|length }} term{{ 's' if grid.relaxed|length != 1 }} given up · see proof</div>{% endif %}
      <div><b>{{ "{:,.0f}".format(d.admissions) }}</b> expected admissions · {{ "{:,}".format(d.seats) }} seats on offer</div>
      {% if d.turned_away >= 0.5 %}<div class="given-up">{{ "{:,.0f}".format(d.turned_away) }} turned away at capacity</div>{% endif %}
      <div>doors {{ brief.policy.open }} · last start {{ brief.policy.last_start }} · turnaround {{ brief.policy.clean_min }}′{% if brief.policy.school_holiday %} · school holidays{% endif %}{% if brief.day_name %} · {{ brief.day_name }}{% endif %}</div>
      <div>solved in {{ grid.solve_seconds }}s</div>
    </div>
  </header>
  <div class="divider"></div>

  {{ day.grid(brief, d) }}
  {{ day.tables(d, report) }}
  {{ day.strips(brief, d, (brief.day_name ~ " " if brief.day_name else "") ~ (brief.date or "the day")) }}

  <footer class="mono">
    <span>turnaround · the showtime grid, solved</span>
    <span>objective {{ "{:,.0f}".format(grid.objective) }} expected admissions{% if grid.hold_paid %} after {{ "{:,.0f}".format(grid.hold_paid) }} paid to hold times{% endif %}</span>
  </footer>
</div>
</body>
</html>
