{% import "_day.html.j2" as day %}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ house }} — terms — {{ span or "the day" }} — turnaround</title>
{{ day.style() }}
<style>
  .terms-page { position:relative; margin-top:56px; padding-top:28px; border-top:1px solid var(--ink); }
  .terms-page:first-of-type { margin-top:0; padding-top:0; border-top:0; }
  .terms-page h2 { font-family:"Space Grotesk", "Helvetica Neue", Helvetica, Arial, sans-serif; font-weight:700; font-size:40px; line-height:.92; letter-spacing:-.03em; margin:0 0 8px; position:relative; }
  .terms-page h2 .ghost { position:absolute; left:3px; top:3px; color:var(--orange); opacity:.09; pointer-events:none; }
  .terms-head { display:grid; grid-template-columns:1.15fr .85fr; gap:24px; align-items:end; margin-bottom:18px; }
  table.terms { font-family:"JetBrains Mono", ui-monospace, Menlo, monospace; font-size:11.5px; letter-spacing:.02em; }
  table.terms th { font-family:"JetBrains Mono", ui-monospace, Menlo, monospace; text-transform:uppercase; letter-spacing:.14em; font-size:10px; white-space:nowrap; }
  table.terms td.term { white-space:nowrap; font-weight:500; }
  table.terms td.scope { color:var(--grey); white-space:nowrap; }
  table.terms td.verdict { white-space:nowrap; }
  .honoured { color:var(--blue); }
  .unmet { color:var(--red); font-weight:600; }
  .given { display:inline-block; color:var(--red); border:1px solid var(--red); padding:1px 5px; transform:rotate(-1.2deg); font-size:10px; }
  .sched { margin-top:26px; }
  .sched .row { display:grid; grid-template-columns:150px 1fr; min-height:0; padding:7px 0; border-bottom:1px dashed rgba(26,26,26,.25); font-family:"JetBrains Mono", ui-monospace, Menlo, monospace; font-size:11.5px; letter-spacing:.02em; line-height:1.7; }
  .sched .row .d { color:var(--grey); text-transform:uppercase; letter-spacing:.14em; font-size:10.5px; padding-top:2px; }
  .sched .s { display:inline-block; margin-right:14px; white-space:nowrap; }
  .sched .s i { font-style:normal; color:var(--grey); }
  .sched .s.prime { border-bottom:2px solid var(--blue); }
  .sched .dark { color:var(--grey); }
  .verdict-stamp { display:inline-block; border:1.5px solid var(--blue); color:var(--blue); padding:5px 10px; transform:rotate(-2deg); font-size:12px; letter-spacing:.18em; }
  .verdict-stamp.bad { border-color:var(--red); color:var(--red); }
  /* the terms sheet is a letter to the distributor: A4 portrait, one title per page */
  @page letter { size:A4 portrait; margin:14mm 16mm; }
  .sheet { page:letter; }
  table.terms td { vertical-align:top; }
  @media print { footer { page:letter; } .terms-page { break-before:page; page-break-before:always; border-top:0; margin-top:0; padding-top:3px; } .terms-page:first-of-type { break-before:auto; page-break-before:auto; } h1 { font-size:34px; } .terms-page h2 { font-size:30px; } .sched .row { grid-template-columns:110px 1fr; } }
  @media screen and (max-width:800px) { .terms-head { grid-template-columns:1fr; } .sched .row { grid-template-columns:1fr; } .sched .row .d { padding-bottom:4px; } }
</style>
</head>
<body>
<div class="sheet">
  <div class="wash"></div>
  <header>
    <div>
      <div class="stamp mono">Terms sheet · {{ sheets|length }} title{{ 's' if sheets|length != 1 }}{% if days|length > 1 %} · {{ days|length }} days{% endif %}</div>
      <h1><span class="ghost" aria-hidden="true">{{ house }}</span>{{ house }}</h1>
    </div>
    <div class="meta mono">
      <div><b>{{ span or "the day" }}</b></div>
      <div>what each booking asked · what the grid delivered · where in the week</div>
      <div>verdicts by the independent checker, not the solver</div>
    </div>
  </header>
  <div class="divider"></div>

  {% for sh in sheets %}
  <section class="terms-page">
    <div class="terms-head">
      <div>
        <div class="stamp mono">{{ sh.film.id }} · {{ sh.rows|length }} term{{ 's' if sh.rows|length != 1 }}</div>
        <h2><span class="ghost" aria-hidden="true">{{ sh.film.title }}</span>{{ sh.film.title }}</h2>
        <div class="mono" style="color:var(--grey)">{{ sh.film.runtime_min }}′ · {{ sh.film.format }}{% if sh.film.rating %} · {{ sh.film.rating }}{% endif %}{% if sh.film.credits_min %} · credits {{ sh.film.credits_min }}′{% endif %}</div>
      </div>
      <div class="meta mono">
        <div><b>{{ sh.shows }}</b> session{{ 's' if sh.shows != 1 }} · {{ sh.primes }} in prime</div>
        <div style="margin-top:8px">{% if sh.honoured %}<span class="verdict-stamp">every term honoured</span>{% else %}<span class="verdict-stamp bad">{% if sh.not_met %}{{ sh.not_met }} not met{% endif %}{% if sh.not_met and sh.given_up %} · {% endif %}{% if sh.given_up %}{{ sh.given_up }} given up{% endif %}</span>{% endif %}</div>
      </div>
    </div>
    {% if sh.rows %}
    <div class="scroll"><table class="terms">
      <thead><tr><th>Term</th><th>Scope</th><th>As booked</th><th>As delivered</th><th>Verdict</th></tr></thead>
      <tbody>
      {% for r in sh.rows %}
      <tr>
        <td class="term">{{ r.term }}</td>
        <td class="scope">{{ r.scope }}</td>
        <td>{{ r.asked }}</td>
        <td>{{ r.delivered }}</td>
        <td class="verdict">{% if r.verdict == "honoured" %}<span class="honoured">✓ honoured</span>{% elif r.verdict == "given up" %}<span class="given">given up</span> {{ r.where }}{% elif r.verdict == "not met" %}<span class="unmet">✗ not met</span> {{ r.where }}{% else %}<span style="color:var(--grey)">unchecked</span>{% endif %}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% else %}<p class="mono" style="color:var(--grey)">no terms booked — plays where the grid wants it</p>{% endif %}
    <div class="sched">
      <div class="stamp mono">As delivered</div>
      {% for d in sh.schedule %}
      <div class="row">
        <div class="d">{{ d.day }}{% if d.date %} <span style="letter-spacing:.06em">{{ d.date[5:] }}</span>{% endif %}</div>
        <div>{% if d.status not in ("OPTIMAL", "FEASIBLE") %}<span class="status-inf">{{ d.status }}</span>{% elif d.sessions %}{% for s in d.sessions %}<span class="s{% if s.prime %} prime{% endif %}">{{ s.start }} <i>{{ s.screen }}</i></span>{% endfor %}{% else %}<span class="dark">—</span>{% endif %}</div>
      </div>
      {% endfor %}
      <div class="legend mono"><span><i style="border:0;border-bottom:2px solid var(--blue);height:6px;width:18px"></i>starts in prime</span></div>
    </div>
  </section>
  {% endfor %}

  <footer class="mono">
    <span>turnaround · the showtime grid, solved</span>
    <span>every verdict re-derived by a checker that shares no code with the solver</span>
  </footer>
</div>
</body>
</html>
